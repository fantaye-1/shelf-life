# Copy to .env (which git ignores) and fill in real values. Never commit .env.
PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/shelflife
DATABASE_USERNAME=shelflife
DATABASE_PASSWORD=change-me
# "log" prints digest emails to the log instead of sending them.
MAIL_PROVIDER=log
# Store-local hour (0-23) when the morning expiry digest goes out.
DIGEST_SEND_HOUR=7
